{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Source Market Concentration Over Time by State, 2022–2024",
    "subtitle": "Top-3 country share of international arrivals (%). Darker = more concentrated on fewer countries.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/state_character.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelFontSize": 12,
        "labelAngle": 0,
        "titleFontSize": 11
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "top3_share_pct",
        "op": "mean",
        "order": "descending"
      },
      "axis": {
        "labelFontSize": 10,
        "labelLimit": 180
      }
    },
    "color": {
      "field": "top3_share_pct",
      "type": "quantitative",
      "title": "Top-3 Share (%)",
      "scale": {
        "domain": [
          40,
          100
        ],
        "range": [
          "#BDD7EE",
          "#1F4E79"
        ]
      },
      "legend": {
        "titleFontSize": 10,
        "labelFontSize": 10,
        "orient": "right"
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State of Entry"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "top3_share_pct",
        "title": "Top-3 Share (%)",
        "format": ".1f"
      },
      {
        "field": "top1_country",
        "title": "Top Source Market"
      },
      {
        "field": "top2_country",
        "title": "2nd Source Market"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}