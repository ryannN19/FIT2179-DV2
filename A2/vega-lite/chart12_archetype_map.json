{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Malaysia's Tourism Archetypes by State",
    "subtitle": "Each state classified by tourism magnitude (volume) and character (source market diversity).",
    "subtitleFontSize": 11,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "data"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.shapeName == 'Malacca' ? 'Melaka' : datum.properties.shapeName == 'Penang' ? 'Pulau Pinang' : datum.properties.shapeName == 'Kuala Lumpur' ? 'W.P. Kuala Lumpur' : datum.properties.shapeName == 'Labuan' ? 'W.P. Labuan' : datum.properties.shapeName == 'Putrajaya' ? 'W.P. Putrajaya' : datum.properties.shapeName",
          "as": "state_name"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/derived_metrics.csv"
            },
            "key": "state",
            "fields": [
              "archetype",
              "magnitude_score",
              "character_score",
              "top1_country",
              "dom_visitors_2024_000",
              "top3_share_pct"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "archetype",
          "type": "nominal",
          "scale": {
            "domain": [
              "Global Hub",
              "Single-Market Dependent",
              "Niche Diversified",
              "Peripheral Concentrated",
              "Domestic-reliant"
            ],
            "range": [
              "#1F4E79",
              "#C00000",
              "#00B050",
              "#FFC000",
              "#7030A0"
            ]
          },
          "legend": {
            "title": "Tourism Archetype",
            "titleFontSize": 11,
            "labelFontSize": 11,
            "orient": "bottom-right",
            "symbolSize": 180
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "archetype",
            "title": "Archetype"
          },
          {
            "field": "top1_country",
            "title": "Top Source Market"
          },
          {
            "field": "top3_share_pct",
            "title": "Top-3 Market Share (%)",
            "format": ".1f"
          },
          {
            "field": "magnitude_score",
            "title": "Magnitude Score",
            "format": ".2f"
          },
          {
            "field": "character_score",
            "title": "Character Score",
            "format": ".2f"
          },
          {
            "field": "dom_visitors_2024_000",
            "title": "Domestic Visitors ('000)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}