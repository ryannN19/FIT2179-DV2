{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic Tourism Magnitude by State, 2024",
    "subtitle": "Domestic visitor arrivals in thousands ('000). Darker blue = more visitors. Source: DOSM Tourism Satellite Account 2024.",
    "fontSize": 20,
    "subtitleFontSize": 11,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 460,
  "projection": {
    "type": "mercator",
    "scale": 3000,
    "center": [
      109.5,
      4.0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "data"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.shapeName == 'Malacca' ? 'Melaka' : datum.properties.shapeName == 'Penang' ? 'Pulau Pinang' : datum.properties.shapeName == 'Kuala Lumpur' ? 'W.P. Kuala Lumpur' : datum.properties.shapeName == 'Labuan' ? 'W.P. Labuan' : datum.properties.shapeName == 'Putrajaya' ? 'W.P. Putrajaya' : datum.properties.shapeName",
          "as": "state_name"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/domestic_state_2024.csv"
            },
            "key": "state",
            "fields": [
              "visitors_000"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "visitors_000",
          "type": "quantitative",
          "title": "Visitors ('000)",
          "scale": {
            "domain": [
              0,
              35000
            ],
            "range": [
              "#D6E8F7",
              "#2E75B6",
              "#1F4E79"
            ]
          },
          "legend": {
            "titleFontSize": 10,
            "labelFontSize": 10,
            "orient": "bottom-right",
            "format": ",.0f",
            "gradientLength": 120
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "visitors_000",
            "title": "Visitors ('000)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}