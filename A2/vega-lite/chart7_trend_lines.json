{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top Source Markets: Tourist Arrivals Trend, 2019–2024",
    "subtitle": "Number of arrivals trend from different countries",
    "fontSize": 20,
    "subtitleFontSize": 11,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/arrivals_country.csv"
  },
  "transform": [
    {
      "filter": "datum.country == 'SGP' || datum.country == 'CHN' || datum.country == 'IDN' || datum.country == 'THA' || datum.country == 'BRN'"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 50
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "arrivals",
          "type": "quantitative",
          "title": "Tourist Arrivals",
          "axis": {
            "labelFontSize": 10,
            "titleFontSize": 11,
            "format": ",.0f",
            "grid": true,
            "gridColor": "#EEE"
          }
        },
        "color": {
          "field": "country_name",
          "type": "nominal",
          "scale": {
            "domain": [
              "Singapore",
              "China",
              "Indonesia",
              "Thailand",
              "Brunei"
            ],
            "range": [
              "#1F4E79",
              "#C00000",
              "#00B050",
              "#FFC000",
              "#7030A0"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "country_name",
            "title": "Country"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "arrivals",
            "title": "Arrivals",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#999",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": "2022",
          "type": "ordinal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": 170,
        "fontSize": 10,
        "color": "#555"
      },
      "encoding": {
        "x": {
          "datum": "2022",
          "type": "ordinal"
        },
        "y": {
          "value": 15
        },
        "text": {
          "value": "Borders"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#999",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": "2022",
          "type": "ordinal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": 180,
        "fontSize": 10,
        "color": "#555"
      },
      "encoding": {
        "x": {
          "datum": "2022",
          "type": "ordinal"
        },
        "y": {
          "value": 15
        },
        "text": {
          "value": "reopen"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#C00000",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": "2023",
          "type": "ordinal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": 150,
        "fontSize": 10,
        "font": "Arial",
        "color": "#C00000"
      },
      "encoding": {
        "x": {
          "datum": "2023",
          "type": "ordinal"
        },
        "y": {
          "value": 15
        },
        "text": {
          "value": "China visa-free"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}