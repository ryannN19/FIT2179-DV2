      "params": [
        {
          "name": "archetype_select",
          "select": {
            "type": "point",
            "fields": [
              "archetype"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 180
      },
      "encoding": {
        "x": {
          "field": "character_score",
          "type": "quantitative",
          "title": "Character Score \u2014 Source Market Diversity (0 = concentrated, 1 = diverse)",
          "scale": {
            "domain": [
              -0.05,
              1.05
            ]
          },
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "titleFontSize": 13,
            "titleFont": "Arial",
            "grid": true,
            "gridColor": "#E3F6FC"
          }
        },
        "y": {
          "field": "magnitude_score",
          "type": "quantitative",
          "title": "Magnitude Score \u2014 Domestic Visitors per Capita (0 = low, 1 = high)",
          "scale": {
            "domain": [
              -0.05,
              1.05
            ]
          },
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "titleFontSize": 13,
            "titleFont": "Arial",
            "grid": true,
            "gridColor": "#E3F6FC"
          }
        },
        "color": {
          "field": "archetype",
          "type": "nominal",
          "scale": {
            "domain": [
              "Single-Market Dependent",
              "Niche Diversified",
              "Peripheral Concentrated",
              "Domestic-reliant"
            ],
            "range": [
              "#E53935",
              "#CE93D8",
              "#FFD600",
              "#7B1FA2"
            ]
          },
          "legend": {
            "title": "Archetype",
            "titleFontSize": 13,
            "titleFont": "Arial",
            "labelFontSize": 13,
            "labelFont": "Arial",
            "orient": "top"
          }
        },
        "opacity": {
          "condition": {
            "param": "archetype_select",
            "value": 0.85
          },
          "value": 0.1
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "archetype",
            "title": "Archetype"
          },
          {
            "field": "magnitude_score",
            "title": "Magnitude Score",
            "format": ".2f"
          },
          {
            "field": "character_score",
            "title": "Character Score",
            "format": ".2f"
          },
          {
            "field": "dom_visitors_per_capita",
            "title": "Visitors per Capita",
            "format": ".1f"
          },
          {
            "field": "top3_share_pct",
            "title": "Top-3 Market Share (%)",
            "format": ".1f"
          },
          {
            "field": "top1_country",
            "title": "Top Source Market"
          }
        ]
      }
