  "params": [
    {
      "name": "year_select",
      "value": null,
      "bind": {
        "input": "select",
        "options": [
          null,
          2022,
          2023,
          2024
        ],
        "labels": [
          "All Years",
          "2022",
          "2023",
          "2024"
        ],
        "name": "Highlight Year: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "year_select == null || datum.year == year_select ? 1 : 0",
      "as": "is_selected"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "labelAngle": 0,
            "titleFontSize": 13,
            "titleFont": "Arial"
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "top3_share_pct",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "labelLimit": 180
          }
        },
        "color": {
          "field": "top3_share_pct",
          "type": "quantitative",
          "title": "Top-3 Share (%)",
          "scale": {
            "domain": [
              30,
              100
            ],
            "range": [
              "#B3E5FC",
              "#01579B"
            ]
          },
          "legend": {
            "titleFontSize": 13,
            "titleFont": "Arial",
            "labelFontSize": 13,
            "labelFont": "Arial",
            "orient": "right"
          }
        },
        "opacity": {
          "field": "is_selected",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              0.15,
              1
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State of Entry"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "top3_share_pct",
            "title": "Top-3 Share (%)",
            "format": ".1f"
          },
          {
            "field": "top1_country",
            "title": "Top Source Market"
          },
          {
            "field": "top2_country",
            "title": "2nd Source Market"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "font": "Arial",
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "top3_share_pct",
            "op": "max",
            "order": "descending"
          }
        },
        "text": {
          "field": "top3_share_pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "opacity": {
          "field": "is_selected",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              0.15,
              1
            ]
          },
          "legend": null
        }
      }
    }
