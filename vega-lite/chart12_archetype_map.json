{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Malaysia's Tourism Archetypes by State",
    "subtitle": [
      "Each state classified by tourism magnitude (volume) and character (source market diversity).",
      "Use dropdown to highlight a specific archetype."
    ],
    "fontSize": 25,
    "subtitleFontSize": 18,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10,
    "font": "Arial",
    "subtitleFont": "Arial"
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "archetype_filter",
      "value": null,
      "bind": {
        "input": "select",
        "options": [
          null,
          "Domestic-reliant",
          "Niche Diversified",
          "Peripheral Concentrated",
          "Single-Market Dependent"
        ],
        "labels": [
          "Show All",
          "Domestic-reliant",
          "Niche Diversified",
          "Peripheral Concentrated",
          "Single-Market Dependent"
        ],
        "name": "Highlight Archetype: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "data"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E0E0E0",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "data"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.shapeName == 'Malacca' ? 'Melaka' : datum.properties.shapeName == 'Penang' ? 'Pulau Pinang' : datum.properties.shapeName == 'Kuala Lumpur' ? 'W.P. Kuala Lumpur' : datum.properties.shapeName == 'Labuan' ? 'W.P. Labuan' : datum.properties.shapeName == 'Putrajaya' ? 'W.P. Putrajaya' : datum.properties.shapeName",
          "as": "state_name"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
