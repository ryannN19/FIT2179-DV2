            },
            "key": "state",
            "fields": [
              "archetype",
              "magnitude_score",
              "character_score",
              "top1_country",
              "dom_visitors_2024_000",
              "top3_share_pct",
              "dom_visitors_per_capita"
            ]
          }
        },
        {
          "calculate": "archetype_filter == null || datum.archetype == archetype_filter ? 1 : 0.1",
          "as": "is_selected"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "archetype",
          "type": "nominal",
          "scale": {
            "domain": [
              "Single-Market Dependent",
              "Niche Diversified",
              "Peripheral Concentrated",
              "Domestic-reliant"
            ],
            "range": [
              "#E53935",
              "#00838F",
              "#FFD600",
              "#7B1FA2"
            ]
          },
          "legend": {
            "title": "Tourism Archetype",
            "titleFontSize": 13,
            "titleFont": "Arial",
            "labelFontSize": 13,
            "labelFont": "Arial",
            "orient": "bottom-right",
            "symbolSize": 200
          }
        },
        "opacity": {
          "field": "is_selected",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.1,
              1
            ],
            "range": [
              0.1,
              1
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "archetype",
            "title": "Archetype"
          },
          {
            "field": "top1_country",
            "title": "Top Source Market"
          },
          {
            "field": "top3_share_pct",
            "title": "Top-3 Market Share (%)",
            "format": ".1f"
          },
          {
            "field": "magnitude_score",
            "title": "Magnitude Score",
            "format": ".2f"
          },
          {
            "field": "character_score",
            "title": "Character Score",
            "format": ".2f"
          },
          {
            "field": "dom_visitors_2024_000",
            "title": "Domestic Visitors ('000)",
            "format": ",.0f"
          },
          {
            "field": "dom_visitors_per_capita",
            "title": "Visitors per Capita",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}