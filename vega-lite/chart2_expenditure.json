    "fontSize": 25,
    "subtitleFontSize": 18,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10,
    "font": "Arial",
    "subtitleFont": "Arial"
  },
  "width": "container",
  "height": 400,
