  },
  "layer": [
    {
      "params": [
        {
          "name": "series_select",
          "select": {
            "type": "point",
            "fields": [
              "type_label"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 3,
        "cornerRadiusTopRight": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "YEAR",
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "labelAngle": 0,
            "titleFontSize": 13,
            "titleFont": "Arial"
          }
        },
        "y": {
          "field": "expenditure",
          "type": "quantitative",
          "title": "Expenditure (RM Billion)",
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "titleFontSize": 13,
            "titleFont": "Arial",
            "grid": true,
            "gridColor": "#E3F6FC"
          }
        },
        "color": {
          "field": "type_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Inbound (Foreign Visitors)",
              "Domestic (Malaysians)"
            ],
            "range": [
              "#0277BD",
              "#FFD600"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "labelFontSize": 13,
            "labelFont": "Arial",
            "labelLimit": 300,
            "columns": 1
          }
        },
        "xOffset": {
          "field": "type_label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "param": "series_select",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "type_label",
            "title": "Type"
          },
          {
            "field": "expenditure",
            "title": "RM Billion",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#E53935",
        "strokeWidth": 1.2,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": "2021",
          "type": "ordinal"
        },
        "y": {
          "datum": 17.5
        },
        "y2": {
          "datum": 30
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "color": "white",
        "opacity": 0.9,
        "width": 160,
        "height": 20,
        "xOffset": 0
      },
      "encoding": {
        "x": {
          "datum": "2021",
          "type": "ordinal"
        },
        "y": {
          "datum": 38
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 12,
        "font": "Arial",
        "color": "#E53935",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "datum": "2021",
          "type": "ordinal"
        },
        "y": {
          "datum": 38
        },
        "text": {
          "value": "Domestic: 35\u00d7 inbound"
        }
      }
    }
