{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Inbound vs Domestic Tourism Expenditure, 2019\u20132024",
    "subtitle": [
      "RM Billion. Inbound = spending by foreign visitors. Domestic = spending by Malaysians.",
      "Click a series in the legend to highlight it."
