{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic Tourism Recovery: 2020 vs 2024 Visitor Arrivals",
    "subtitle": "Visitors in thousands ('000). Left point = 2020 (pandemic low). Right point = 2024 (recovery).",
    "fontSize": 25,
    "subtitleFontSize": 18,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10,
    "font": "Arial",
    "subtitleFont": "Arial"
  },
  "width": "container",
  "height": 440,
  "data": {
    "url": "data/domestic_state_long.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2020 || datum.year == 2024"
    },
    {
      "filter": "datum.state != 'MALAYSIA TOTAL'"
    },
    {
      "pivot": "year",
      "value": "visitors_000",
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "datum['2024'] - datum['2020']",
      "as": "growth"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#B3E5FC"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "labelLimit": 180
          }
        },
        "x": {
          "field": "2020",
          "type": "quantitative",
          "title": "Domestic Visitors ('000)",
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "titleFontSize": 13,
            "titleFont": "Arial",
            "grid": true,
            "gridColor": "#E3F6FC"
          }
        },
        "x2": {
          "field": "2024"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "color": "#FFD600",
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          }
        },
        "x": {
          "field": "2020",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "2020",
            "title": "2020 Visitors ('000)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "color": "#0277BD",
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          }
        },
        "x": {
          "field": "2024",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "2024",
            "title": "2024 Visitors ('000)",
            "format": ",.0f"
          },
          {
            "field": "growth",
            "title": "Growth ('000)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "color": "#FFD600",
        "opacity": 1,
        "x": 555,
        "y": 420
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "font": "Arial",
        "color": "#333",
        "x": 565,
        "y": 420,
        "text": "2020 (Pandemic low)"
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "color": "#0277BD",
        "opacity": 1,
        "x": 695,
        "y": 420
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "font": "Arial",
        "color": "#333",
        "x": 700,
        "y": 420,
        "text": "2024 (Recovery)"
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Selangor'"
        }
      ],
      "mark": {
        "type": "rect",
        "color": "white",
        "opacity": 0.9,
        "width": 170,
        "height": 18,
        "xOffset": 0,
        "yOffset": 28
      },
      "encoding": {
        "x": {
          "field": "2024",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Selangor'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": 0,
        "fontSize": 12,
        "font": "Arial",
        "color": "#0277BD",
        "yOffset": 28
      },
      "encoding": {
        "x": {
          "field": "2024",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          }
        },
        "text": {
          "value": "+14,746k — largest recovery"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Selangor'"
        }
      ],
      "mark": {
        "type": "text",
        "text": "|",
        "color": "#0277BD",
        "fontSize": 14,
        "dx": -30,
        "dy": 10
      },
      "encoding": {
        "x": {
          "field": "2024",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}