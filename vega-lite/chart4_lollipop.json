{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic Tourism Recovery: 2020 vs 2024 Visitor Arrivals",
    "subtitle": "Visitors in thousands ('000). Left point = 2020 (pandemic low). Right point = 2024 (recovery).",
    "fontSize": 20,
    "subtitleFontSize": 11,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 440,
  "data": {
    "url": "data/domestic_state_long.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2020 || datum.year == 2024"
    },
    {
      "filter": "datum.state != 'MALAYSIA TOTAL'"
    },
    {
      "pivot": "year",
      "value": "visitors_000",
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "datum['2024'] - datum['2020']",
      "as": "growth"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#BDD7EE"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 180
          }
        },
        "x": {
          "field": "2020",
          "type": "quantitative",
          "title": "Domestic Visitors ('000)",
          "axis": {
            "labelFontSize": 10,
            "titleFontSize": 11,
            "grid": true,
            "gridColor": "#EEE"
          }
        },
        "x2": {
          "field": "2024"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "color": "#9DC3E6",
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          }
        },
        "x": {
          "field": "2020",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "2020",
            "title": "2020 Visitors ('000)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "color": "#1F4E79",
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "2024",
            "order": "descending"
          }
        },
        "x": {
          "field": "2024",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "2024",
            "title": "2024 Visitors ('000)",
            "format": ",.0f"
          },
          {
            "field": "growth",
            "title": "Growth ('000)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}