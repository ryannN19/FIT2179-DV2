  "params": [
    {
      "name": "year_select",
      "value": 2024,
      "bind": {
        "input": "select",
        "options": [
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "name": "Select Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year == year_select"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "arrivals",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 10"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "arrivals",
          "as": "total_arrivals"
        }
      ]
    },
    {
      "calculate": "datum.arrivals / datum.total_arrivals * 100",
      "as": "share_pct"
    },
    {
      "calculate": "datum.country_name === 'Singapore' ? '#FFD600' : '#0288D1'",
      "as": "bar_color"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "country_name",
          "type": "nominal",
          "sort": {
            "field": "share_pct",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "labelLimit": 150
          }
        },
        "x": {
          "field": "share_pct",
          "type": "quantitative",
          "title": "Share of Top 10 Arrivals (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "labelFontSize": 13,
            "labelFont": "Arial",
            "titleFontSize": 13,
            "titleFont": "Arial",
            "format": ".1f"
          }
        },
        "color": {
          "field": "bar_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {
            "field": "country_name",
            "title": "Country"
          },
          {
            "field": "share_pct",
            "title": "Share (%)",
            "format": ".1f"
          },
          {
            "field": "arrivals",
            "title": "Raw Arrivals",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 13,
        "font": "Arial",
        "color": "#333"
      },
      "encoding": {
        "y": {
          "field": "country_name",
          "type": "nominal",
          "sort": {
            "field": "share_pct",
            "order": "descending"
          }
        },
        "x": {
          "field": "share_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "share_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}