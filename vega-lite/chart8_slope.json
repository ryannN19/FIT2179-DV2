{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic Tourism Recovery by State: 2020 vs 2024",
    "subtitle": "Domestic visitor arrivals in thousands ('000). Lines show growth trajectory per state.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 440,
  "data": {
    "url": "data/domestic_state_long.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2020 || datum.year == 2024"
    },
    {
      "filter": "datum.state != 'MALAYSIA TOTAL'"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.8,
        "opacity": 0.6
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "visitors_000",
          "type": "quantitative",
          "title": "Domestic Visitors ('000)",
          "axis": {
            "labelFontSize": 10,
            "titleFontSize": 11,
            "grid": true,
            "gridColor": "#EEE"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "legend": null
        },
        "detail": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "visitors_000",
          "type": "quantitative"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "visitors_000",
            "title": "Visitors ('000)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 9.5,
        "fontWeight": "normal"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "visitors_000",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2020"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "fontSize": 9.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "visitors_000",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "legend": null
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}