{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Concentrated is Each State's International Tourism?",
    "subtitle": "Top-3 source country share of arrivals, 2024. Bars right of centre = more concentrated than national average (82%). Bars left = more diversified.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "subtitleColor": "#666",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 520,
  "data": {
    "url": "data/state_character.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2024"
    },
    {
      "calculate": "datum.top3_share_pct - 82.2",
      "as": "deviation_from_mean"
    },
    {
      "calculate": "datum.deviation_from_mean >= 0 ? 'Above average — More Concentrated' : 'Below average — More Diversified'",
      "as": "concentration_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#333",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "deviation_from_mean",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 180,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "deviation_from_mean",
          "type": "quantitative",
          "title": "Deviation from national average concentration (82%)",
          "axis": {
            "labelFontSize": 10,
            "titleFontSize": 11,
            "grid": true,
            "gridColor": "#EEE",
            "labelExpr": "datum.value > 0 ? '+' + round(datum.value) + 'pp' : round(datum.value) + 'pp'"
          }
        },
        "color": {
          "field": "concentration_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Above average — More Concentrated",
              "Below average — More Diversified"
            ],
            "range": [
              "#1F4E79",
              "#00B0F0"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom-right",
            "labelFontSize": 11,
            "labelLimit": 280
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State of Entry"
          },
          {
            "field": "top1_country",
            "title": "Top Source Market"
          },
          {
            "field": "top2_country",
            "title": "2nd Source Market"
          },
          {
            "field": "top3_share_pct",
            "title": "Top-3 Share (%)",
            "format": ".1f"
          },
          {
            "field": "deviation_from_mean",
            "title": "vs National Avg (pp)",
            "format": "+.1f"
          },
          {
            "field": "concentration_label",
            "title": "Classification"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#1F4E79",
        "align": "left",
        "dx": 4,
        "dy": 0
      },
      "transform": [
        {
          "filter": "datum.deviation_from_mean >= 0"
        }
      ],
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "deviation_from_mean",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "deviation_from_mean",
          "type": "quantitative"
        },
        "text": {
          "field": "top3_share_pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#007BAF",
        "align": "right",
        "dx": -4,
        "dy": 0
      },
      "transform": [
        {
          "filter": "datum.deviation_from_mean < 0"
        }
      ],
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "deviation_from_mean",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "deviation_from_mean",
          "type": "quantitative"
        },
        "text": {
          "field": "top3_share_pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 8.5,
        "color": "#666",
        "fontStyle": "italic",
        "align": "left",
        "dx": 4,
        "dy": -8
      },
      "transform": [
        {
          "filter": "datum.deviation_from_mean >= 0"
        }
      ],
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "deviation_from_mean",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "deviation_from_mean",
          "type": "quantitative"
        },
        "text": {
          "field": "top1_country",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 8.5,
        "color": "#666",
        "fontStyle": "italic",
        "align": "right",
        "dx": -4,
        "dy": -8
      },
      "transform": [
        {
          "filter": "datum.deviation_from_mean < 0"
        }
      ],
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "deviation_from_mean",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "deviation_from_mean",
          "type": "quantitative"
        },
        "text": {
          "field": "top1_country",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#555",
        "fontWeight": "bold",
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "y": {
          "datum": "Negeri Sembilan"
        },
        "text": {
          "value": "← More Diversified    More Concentrated →"
        },
        "align": {
          "value": "center"
        },
        "dy": -12
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}
